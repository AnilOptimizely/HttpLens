<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Drop an unreleased JwtLens .nupkg (e.g. a JwtLens CI artifact) here and pass -p:JwtLensVersion=<version>. -->
    <add key="local-packages" value="packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="JwtLens" />
    </packageSource>
    <packageSource key="local-packages">
      <package pattern="JwtLens" />
    </packageSource>
  </packageSourceMapping>
</configuration>
