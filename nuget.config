<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- CI packs JwtLens here so the regression tests validate the locally built package. -->
    <add key="local-packages" value="packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="local-packages">
      <package pattern="JwtLens" />
    </packageSource>
  </packageSourceMapping>
</configuration>
